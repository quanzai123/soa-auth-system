{
  "info": {
    "_postman_id": "soa-group1-google-oauth2",
    "name": "SOA Group 1 - Google OAuth 2.0 & JWT Auth API",
    "description": "Bộ sưu tập API kiểm thử tự động hóa 100% dành cho Seminar Kiến trúc Hướng Dịch vụ (SOA) - Tự động đồng bộ tài khoản đăng nhập (Gmail cá nhân / Sinh viên / Giảng viên).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "📂 1. CÁC API CÔNG KHAI (PUBLIC APIS)",
      "item": [
        {
          "name": "01. Lấy URL Đăng Nhập Google SSO (RFC 6749)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[PASS] Mã phản hồi 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('[PASS] Sinh thành công URL Google OAuth 2.0', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.url).to.include('accounts.google.com');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/google/url",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "google", "url"]
            },
            "description": "Gọi Gateway sinh đường dẫn ủy quyền Google OAuth 2.0 kèm Client ID và Scope chuẩn."
          }
        },
        {
          "name": "02. Kiểm Tra Cấu Hình Google OAuth 2.0",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[PASS] Mã phản hồi 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('[PASS] Đọc cấu hình Google OAuth 2.0 thành công', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.have.property('redirectUri');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/google/config",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "google", "config"]
            },
            "description": "Kiểm tra trạng thái Client ID và Client Secret phía máy chủ."
          }
        },
        {
          "name": "03. Xem Cơ Sở Dữ Liệu SQL Server Trực Tiếp",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[PASS] Mã phản hồi 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('[PASS] Đọc thành công dữ liệu từ Microsoft SQL Server 2022', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.database).to.eql('google_login_db');",
                  "    pm.expect(json.data.totalUsers).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/public/database-viewer",
              "host": ["{{baseUrl}}"],
              "path": ["api", "public", "database-viewer"]
            },
            "description": "Đọc dữ liệu thực tế từ container Microsoft SQL Server 2022 Docker."
          }
        }
      ]
    },
    {
      "name": "📂 2. BẢO MẬT & XÁC THỰC DANH TÍNH (JWT IDENTITY)",
      "item": [
        {
          "name": "04. Tự Động Đồng Bộ Token Đang Đăng Nhập (Tự Động Nhận Diện Tài Khoản)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[PASS] Mã phản hồi 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('[PASS] Tự động đồng bộ Token của tài khoản đang đăng nhập', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.accessToken).to.be.a('string');",
                  "    pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "    console.log('Đã nạp Token thành công cho:', json.data.user.email, '| Loại:', json.data.user.accountType);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/latest-token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "latest-token"]
            },
            "description": "Tự động lấy token của tài khoản vừa đăng nhập trên trình duyệt web (Gmail cá nhân hoặc Sinh viên) để Postman kiểm thử đúng tài khoản đó."
          }
        },
        {
          "name": "05. Xem Hồ Sơ Người Dùng Đang Đăng Nhập (Có Gửi Bearer Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[PASS] Mã phản hồi 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('[PASS] Xác thực chữ ký số JWT thành công, trả về đúng hồ sơ người dùng', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.email).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.data.accountType).to.be.oneOf(['STUDENT', 'LECTURER', 'PERSONAL']);",
                  "    console.log('Hồ sơ xác thực:', json.data.fullName, '<' + json.data.email + '>', 'Vai trò:', json.data.accountType);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            },
            "description": "Gửi Bearer Token hợp lệ. Spring Security giải mã chữ ký số cục bộ và trả về thông tin hồ sơ của chính tài khoản đang đăng nhập."
          }
        },
        {
          "name": "06. Xem Danh Sách Nhà Cung Cấp Đang Liên Kết",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[PASS] Mã phản hồi 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('[PASS] Lấy danh sách liên kết danh tính thành công', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me/linked-accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me", "linked-accounts"]
            },
            "description": "Xem các cổng đăng nhập OAuth2 (Google) đang liên kết với tài khoản này."
          }
        },
        {
          "name": "07. [PHÒNG THỦ DỮ LIỆU] Chặn Hủy Liên Kết Google Khi Chưa Có Mật Khẩu (Kỳ vọng: 400 Bad Request)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/api/auth/demo-token?noPassword=true',",
                  "    method: 'GET'",
                  "}, function (err, res) {",
                  "    if (!err && res.code === 200) {",
                  "        pm.variables.set('noPasswordToken', res.json().data.accessToken);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[PASS] Ràng buộc bảo vệ dữ liệu thành công: HTTP 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{noPasswordToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me/linked-accounts/google",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me", "linked-accounts", "google"]
            },
            "description": "Kiểm tra ràng buộc nghiệp vụ: Chặn người dùng vô tình hủy Google khi chưa có mật khẩu để tránh tài khoản mồ côi."
          }
        },
        {
          "name": "08. Thiết Lập Mật Khẩu Dự Phòng Cho Tài Khoản (BCrypt)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[PASS] Mã phản hồi 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('[PASS] Đã băm BCrypt và lưu mật khẩu dự phòng vào SQL Server', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"Spring@123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/me/password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me", "password"]
            },
            "description": "Tạo mật khẩu dự phòng băm bằng BCrypt để tránh tình trạng tài khoản mồ côi sau này."
          }
        },
        {
          "name": "09. Tự Động Gia Hạn Token Mới (Refresh Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[PASS] Mã phản hồi 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('[PASS] Cấp phát Access Token mới thành công từ Refresh Token', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.accessToken).to.be.a('string');",
                  "    pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh-token"]
            },
            "description": "Tự động đổi Refresh Token lấy Access Token mới và cập nhật thẳng vào biến hệ thống."
          }
        }
      ]
    },
    {
      "name": "📂 3. KIỂM THỬ PHÒNG THỦ & THU HỒI TOKEN (SECURITY DEFENSE)",
      "item": [
        {
          "name": "10. [PHÒNG THỦ 1] Chặn Người Lạ Không Gửi Token (Kỳ vọng: 403 Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[PASS] Spring Security chặn đứng thành công: HTTP 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            },
            "description": "Gọi API cá nhân nhưng không gửi Bearer Token. Spring Security phát hiện và chặn đứng ngay tại Servlet Filter."
          }
        },
        {
          "name": "11. Đăng Xuất & Thu Hồi Token Vào Blacklist",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[PASS] Mã phản hồi 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('[PASS] Đã ghi nhận chữ ký Token vào Danh Sách Đen (Bounded TTL Blacklist)', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Gửi lệnh đăng xuất. Gateway lưu chữ ký Token vào Bounded TTL Blacklist để vô hiệu hóa tức thì."
          }
        },
        {
          "name": "12. [PHÒNG THỦ 2] Chặn Tấn Công Phát Lại Token Đã Đăng Xuất (Kỳ vọng: 403 Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[PASS] Blacklist chặn đứng Replay Attack thành công: HTTP 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            },
            "description": "Dù Token về mặt toán học chưa hết hạn 15 phút, nhưng JwtAuthenticationFilter phát hiện nằm trong Blacklist và chặn 403 ngay lập tức!"
          }
        }
      ]
    }
  ]
}
