{
  "info": {
    "_postman_id": "soa-group1-google-oauth2",
    "name": "SOA Group 1 - Google OAuth 2.0 & JWT Auth API",
    "description": "Bộ sưu tập API kiểm thử tự động hóa 100% dành cho Seminar Kiến trúc Hướng Dịch vụ (SOA) - Phân định rõ ràng Public API vs Private API, Cơ sở dữ liệu Private, Tự động đồng bộ trực tiếp với Web, Thu hồi quyền và Dừng truy cập ngay lập tức.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "📂 1. CÁC API CÔNG KHAI (PUBLIC APIS - KHÔNG CẦN ĐĂNG NHẬP / TOKEN)",
      "item": [
        {
          "name": "01. Lấy URL Đăng Nhập Google SSO (RFC 6749)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[PASS] Mã phản hồi 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('[PASS] Public API: Sinh thành công URL Google OAuth 2.0', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.url).to.include('accounts.google.com');",
                  "    console.log('🌐 [PUBLIC API]: Cho phép mọi client lấy URL chuyển hướng Google SSO mà không cần bất kỳ định danh nào.');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/google/url",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "google",
                "url"
              ]
            },
            "description": "Public API: Bất kỳ ai cũng có thể gọi để lấy URL ủy quyền Google SSO."
          }
        },
        {
          "name": "02. Kiểm Tra Cấu Hình Google OAuth 2.0",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[PASS] Mã phản hồi 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('[PASS] Public API: Đọc cấu hình OAuth2 công khai thành công', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.have.property('redirectUri');",
                  "    console.log('🌐 [PUBLIC API]: Trả về trạng thái cấu hình SSO (Redirect URI, Client ID) để UI khởi tạo nút bấm.');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/google/config",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "google",
                "config"
              ]
            },
            "description": "Public API: Kiểm tra trạng thái máy chủ SSO đã sẵn sàng hoạt động hay chưa."
          }
        }
      ]
    },
    {
      "name": "📂 2. CÁC API RIÊNG TƯ (PRIVATE APIS - ĐIỀU KIỆN BẮT BUỘC: CÓ BEARER TOKEN HỢP LỆ)",
      "item": [
        {
          "name": "03. Tự Động Đồng Bộ Phiên Hoạt Động Trực Tiếp Từ Web",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.test('[PASS] Đã lấy chính xác tài khoản đang đăng nhập trên Web (200 OK)', function () {",
                  "        var json = pm.response.json();",
                  "        pm.expect(json.success).to.be.true;",
                  "        pm.expect(json.data.accessToken).to.be.a('string');",
                  "        pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "        pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "        console.log('🔄 [LIVE SYNC THÀNH CÔNG]: Web đang đăng nhập tài khoản:', json.data.user.fullName, '<' + json.data.user.email + '>', '| Vai trò:', json.data.user.accountType);",
                  "    });",
                  "} else if (pm.response.code === 401) {",
                  "    pm.test('[PASS] Đúng thiết kế bảo mật: Web chưa đăng nhập thì không lấy được gì (401 Unauthorized)', function () {",
                  "        var json = pm.response.json();",
                  "        pm.expect(json.success).to.be.false;",
                  "        console.log('🔒 [BẢO MẬT TUYỆT ĐỐI]: Web chưa đăng nhập -> Postman bị từ chối lấy dữ liệu đúng như yêu cầu!');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/latest-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "latest-token"
              ]
            },
            "description": "Cơ chế Live Sync: Tự động trích xuất Token và hồ sơ người dùng vừa đăng nhập/thao tác trên trình duyệt Web để các request Private phía sau kiểm thử chính xác tài khoản đó."
          }
        },
        {
          "name": "04. Xem Hồ Sơ Người Dùng Đang Đăng Nhập (Có Bearer Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[PASS] Mã phản hồi 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('[PASS] Private API: Xác thực chữ ký JWT thành công, trả về đúng hồ sơ', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.email).to.be.a('string').and.not.empty;",
                  "    console.log('✅ [PRIVATE API - 200 OK]: Đã xác thực thành công danh tính:', json.data.email, '| Có mật khẩu chưa:', json.data.hasPassword);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            },
            "description": "Private API: Bắt buộc gửi Bearer Access Token. Spring Security giải mã chữ ký JWT và cấp quyền xem hồ sơ."
          }
        },
        {
          "name": "05. Xem Danh Sách Nhà Cung Cấp Đang Liên Kết",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[PASS] Mã phản hồi 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('[PASS] Private API: Lấy danh sách liên kết danh tính thành công', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me/linked-accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me",
                "linked-accounts"
              ]
            },
            "description": "Private API: Xem danh sách các Provider OAuth2 (Google) đang liên kết với tài khoản."
          }
        },
        {
          "name": "06. Xem Cơ Sở Dữ Liệu SQL Server Trực Tiếp (Có Bearer Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[PASS] Mã phản hồi 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('[PASS] Private API: Có Bearer Token hợp lệ -> Cấp quyền xem CSDL SQL Server', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.database).to.eql('google_login_db');",
                  "    pm.expect(json.data.totalUsers).to.be.above(0);",
                  "    pm.expect(json.data.requestedBy).to.be.a('string').and.not.empty;",
                  "    console.log('🔒 [CSDL PRIVATE - 200 OK]: Người dùng', json.data.requestedBy, 'đã xác thực thành công và được phép xem bản chụp CSDL SQL Server.');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/database-viewer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "database-viewer"
              ]
            },
            "description": "Private API (Đã chuyển từ Public sang Private): Chỉ người dùng có Token hợp lệ mới được xem danh sách Users và Identities trong SQL Server."
          }
        },
        {
          "name": "07. Tự Động Gia Hạn Token Mới Bằng Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[PASS] Mã phản hồi 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('[PASS] Cấp phát Access Token mới thành công từ Refresh Token', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data.accessToken).to.be.a('string');",
                  "    pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "    console.log('🔄 [REFRESH TOKEN]: Đã gia hạn thành công Access Token mới.');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh-token"
              ]
            },
            "description": "Cơ chế xoay vòng Refresh Token lấy Access Token mới."
          }
        }
      ]
    },
    {
      "name": "📂 3. BẢO VỆ PHÒNG THỦ & DỪNG TRUY CẬP NGAY LẬP TỨC (ZERO-TRUST & REVOCATION)",
      "item": [
        {
          "name": "08. Đăng Xuất & Thu Hồi Token Vào Blacklist",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[PASS] Mã phản hồi 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('[PASS] Đã ghi nhận chữ ký Token vào Blacklist', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    console.log('⛔ [THU HỒI QUYỀN]: Người dùng Đăng xuất -> Chữ ký Token bị đưa ngay vào Bounded TTL Blacklist!');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Gửi lệnh đăng xuất để thu hồi Token ngay lập tức."
          }
        }
      ]
    }
  ]
}